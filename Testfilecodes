import google.generativeai as genai
import tkinter as tk
from tkinter import ttk, scrolledtext, messagebox, filedialog
import threading
import json
import os
import re
from datetime import datetime
from dotenv import load_dotenv

load_dotenv()

class InquireChatBot:
    def __init__(self, root):
        self.root = root
        self.root.title("Inqui.re - AI Assistant")
        self.root.geometry("700x800")
        self.root.configure(bg='#1E1E1E')
        
        # Style configuration
        self.setup_styles()
        
        # Initialize AI
        self.setup_ai()
        
        # Setup GUI
        self.setup_gui()
        
        # Start with welcome message
        self.add_bot_message("Hello! I'm **Inqui.re**, your AI assistant. How can I help you today? 🌟")
    
    def setup_styles(self):
        """Configure modern styles"""
        self.style = ttk.Style()
        self.style.theme_use('clam')
        
        # Configure colors
        self.colors = {
            'bg': '#1E1E1E',
            'fg': '#FFFFFF',
            'accent': '#007ACC',
            'user_msg': '#4EC9B0',
            'bot_msg': '#CE9178',
            'system_msg': '#569CD6',
            'bold': '#FFD700',
            'italic': '#E6E6FA',
            'heading': '#87CEEB'
        }
    
    def setup_ai(self):
        """Initialize the Google AI API"""
        try:
            self.api_key = os.getenv('GOOGLE_API_KEY')
            if not self.api_key:
                messagebox.showerror("Error", "Please set GOOGLE_API_KEY in your .env file")
                return
            
            genai.configure(api_key=self.api_key)
            
            # Try different models
            model_names = ['gemini-1.5-flash', 'gemini-1.5-pro', 'gemini-pro']
            self.model = None
            
            for name in model_names:
                try:
                    self.model = genai.GenerativeModel(name)
                    print(f"✅ Using model: {name}")
                    break
                except:
                    continue
            
            if not self.model:
                messagebox.showerror("Error", "No working model found")
                return
            
            self.chat = self.model.start_chat(history=[])
            
        except Exception as e:
            messagebox.showerror("Error", f"Failed to initialize AI: {e}")
    
    def render_markdown(self, text_widget, text):
        """
        Render markdown formatting in tkinter text widget
        """
        # Split text into lines for processing
        lines = text.split('\n')
        
        for line in lines:
            if not line.strip():
                text_widget.insert(tk.END, '\n')
                continue
            
            # Check for headings
            heading_match = re.match(r'^(#+)\s+(.*)$', line)
            if heading_match:
                level = len(heading_match.group(1))
                heading_text = heading_match.group(2)
                font_size = {1: 14, 2: 13, 3: 12}.get(level, 11)
                
                text_widget.insert(tk.END, heading_text + '\n', f'heading_{level}')
                continue
            
            # Process inline formatting
            pos = 0
            while pos < len(line):
                # Look for bold **text**
                bold_match = re.search(r'\*\*(.*?)\*\*', line[pos:])
                # Look for italic *text*
                italic_match = re.search(r'\*(.*?)\*', line[pos:])
                # Look for code `text`
                code_match = re.search(r'`(.*?)`', line[pos:])
                
                # Find the earliest match
                matches = []
                if bold_match:
                    matches.append(('bold', bold_match.start() + pos, bold_match))
                if italic_match:
                    matches.append(('italic', italic_match.start() + pos, italic_match))
                if code_match:
                    matches.append(('code', code_match.start() + pos, code_match))
                
                if not matches:
                    # No more formatting, add the rest of the text
                    text_widget.insert(tk.END, line[pos:])
                    break
                
                # Sort matches by position
                matches.sort(key=lambda x: x[1])
                format_type, match_pos, match = matches[0]
                
                # Add text before the formatting
                if match_pos > pos:
                    text_widget.insert(tk.END, line[pos:match_pos])
                
                # Add formatted text
                if format_type == 'bold':
                    text_widget.insert(tk.END, match.group(1), 'bold')
                elif format_type == 'italic':
                    text_widget.insert(tk.END, match.group(1), 'italic')
                elif format_type == 'code':
                    text_widget.insert(tk.END, match.group(1), 'code')
                
                # Move position after the formatted text
                pos = match_pos + len(match.group(0))
            
            text_widget.insert(tk.END, '\n')
    
    def setup_gui(self):
        """Setup the enhanced graphical user interface"""
        # Main container
        main_container = tk.Frame(self.root, bg=self.colors['bg'])
        main_container.pack(fill=tk.BOTH, expand=True, padx=15, pady=15)
        
        # Header
        header_frame = tk.Frame(main_container, bg=self.colors['bg'])
        header_frame.pack(fill=tk.X, pady=(0, 10))
        
        title_label = tk.Label(
            header_frame,
            text="🔍 Inqui.re - AI Assistant",
            font=('Arial', 18, 'bold'),
            fg=self.colors['accent'],
            bg=self.colors['bg']
        )
        title_label.pack(side=tk.LEFT)
        
        # Status indicator
        self.status_var = tk.StringVar(value="🟢 Online")
        status_label = tk.Label(
            header_frame,
            textvariable=self.status_var,
            font=('Arial', 10),
            fg='#00FF00',
            bg=self.colors['bg']
        )
        status_label.pack(side=tk.RIGHT)
        
        # Chat display with modern styling
        chat_frame = tk.Frame(main_container, bg=self.colors['bg'])
        chat_frame.pack(fill=tk.BOTH, expand=True, pady=10)
        
        self.chat_display = scrolledtext.ScrolledText(
            chat_frame,
            wrap=tk.WORD,
            width=70,
            height=25,
            font=('Segoe UI', 10),
            bg='#252526',
            fg=self.colors['fg'],
            state=tk.DISABLED,
            relief=tk.FLAT,
