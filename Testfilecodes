            pady=15
        )
        self.chat_display.pack(fill=tk.BOTH, expand=True)
        
        # Configure message styles with markdown support
        self.chat_display.tag_config('user', 
                                   foreground=self.colors['user_msg'], 
                                   justify='right', 
                                   font=('Segoe UI', 10, 'bold'))
        
        self.chat_display.tag_config('bot', 
                                   foreground=self.colors['bot_msg'], 
                                   justify='left', 
                                   font=('Segoe UI', 10))
        
        self.chat_display.tag_config('system', 
                                   foreground=self.colors['system_msg'], 
                                   justify='center', 
                                   font=('Segoe UI', 9, 'italic'))
        
        # Markdown formatting tags
        self.chat_display.tag_config('bold', 
                                   font=('Segoe UI', 10, 'bold'),
                                   foreground=self.colors['bold'])
        
        self.chat_display.tag_config('italic', 
                                   font=('Segoe UI', 10, 'italic'),
                                   foreground=self.colors['italic'])
        
        self.chat_display.tag_config('code', 
                                   font=('Courier New', 10),
                                   background='#2D2D2D',
                                   foreground='#D4D4D4')
        
        # Heading tags
        self.chat_display.tag_config('heading_1', 
                                   font=('Segoe UI', 14, 'bold'),
                                   foreground=self.colors['heading'])
        
        self.chat_display.tag_config('heading_2', 
                                   font=('Segoe UI', 13, 'bold'),
                                   foreground=self.colors['heading'])
        
        self.chat_display.tag_config('heading_3', 
                                   font=('Segoe UI', 12, 'bold'),
                                   foreground=self.colors['heading'])
        
        # Input area
        input_frame = tk.Frame(main_container, bg=self.colors['bg'])
        input_frame.pack(fill=tk.X, pady=10)
        
        self.message_entry = tk.Entry(
            input_frame,
            font=('Segoe UI', 12),
            bg='#3C3C3C',
            fg=self.colors['fg'],
            insertbackground=self.colors['fg'],
            relief=tk.FLAT,
            borderwidth=8
        )
        self.message_entry.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=(0, 10))
        self.message_entry.bind('<Return>', self.send_message)
        
        self.send_button = tk.Button(
            input_frame,
            text="🔍 Ask",
            command=self.send_message,
            font=('Segoe UI', 10, 'bold'),
            bg=self.colors['accent'],
            fg='white',
            activebackground='#005A9E',
            activeforeground='white',
            relief=tk.FLAT,
            borderwidth=0,
            padx=20
        )
        self.send_button.pack(side=tk.RIGHT)
        
        # Control buttons
        controls_frame = tk.Frame(main_container, bg=self.colors['bg'])
        controls_frame.pack(fill=tk.X)
        
        buttons = [
            ("🆕 New Chat", self.new_chat, '#28A745'),
            ("🗑️ Clear", self.clear_chat, '#DC3545'),
            ("💾 Save Chat", self.save_chat, '#FFC107'),
            ("📤 Export", self.export_chat, '#17A2B8')
